# Use a Supabase direct connection string. Keep it only in your local .env.
# Runtime URL: use the Supabase Transaction pooler for serverless deployments.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1"
# Migration URL: use the Supabase Session pooler.
DIRECT_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
JUNTOS_SE_FAZ_TOKEN=""
JUNTOS_SE_FAZ_BASE_URL="https://www.juntosefaz.com.br/gateway/api/v1"
PAYFLOW_ENABLE_SANDBOX_SIMULATION="true"
NODE_ENV="development"
